<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="appli.accueil.ResetPasswordController"
      alignment="CENTER"
      spacing="15">

    <Label text="Mot de passe oublié" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <Label text="Entrez votre adresse e-mail :" />
    <TextField fx:id="emailField" promptText="Votre e-mail" prefWidth="250"/>

    <Button text="Envoyer le code"
            onAction="#valider" />

    <Label fx:id="labelCode" text="Entrez le code reçu :" visible="false" managed="false"/>
    <TextField fx:id="codeField" promptText="Code à 6 chiffres" prefWidth="250"
               visible="false" managed="false"/>
    <Button text="Vérifier le code"
            onAction="#verifierCode"
            fx:id="btnVerifier"
            visible="false" managed="false"/>

    <Label fx:id="messageLabel" text=""/>

</VBox>
